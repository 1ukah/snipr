# Alternativa ao cofre do app (os valores colados na interface têm prioridade).
# Copie para .env na pasta do app ou em %APPDATA%\snipr\.env (Windows),
# ~/Library/Application Support/snipr/.env (macOS), ~/.config/snipr/.env (Linux).

# Claude Code (assinatura): gere com `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic API
ANTHROPIC_API_KEY=

# Provedor compatível com OpenAI (OpenAI, xAI, Gemini, OpenRouter...)
SNIPR_OPENAI_API_KEY=
